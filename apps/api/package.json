{
  "name": "@dipbuyer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: api'",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "prisma": { "schema": "prisma/schema.prisma" },
  "dependencies": {
    "@dipbuyer/shared": "workspace:*",
    "@dipbuyer/strategy": "workspace:*",
    "@dipbuyer/data": "workspace:*",
    "@dipbuyer/brokers": "workspace:*",
    "@dipbuyer/backtest": "workspace:*",
    "@dipbuyer/chain": "workspace:*",
    "@dipbuyer/agent": "workspace:*",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@prisma/client": "^5.22.0",
    "jose": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "vitest": "^4.1.11"
  }
}
