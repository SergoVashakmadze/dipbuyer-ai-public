# Copy to .env.local. Next.js loads env files from apps/web/ ONLY — the monorepo
# root .env is invisible to `next dev` / `next build`, so these must be duplicated here.
# All NEXT_PUBLIC_* are baked into the client bundle => public. No secrets in this file.

NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Auth0 (see AUTH0-TENANT.md). Leave DOMAIN or CLIENT_ID blank to run with auth disabled:
# AuthProvider goes inert and the Sign-in button is hidden.
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.dipbuyer.ai
