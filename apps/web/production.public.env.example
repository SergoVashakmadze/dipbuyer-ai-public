# Public build-time settings for a production web build. Copy to production.public.env and fill in
# YOUR OWN values; the cf:build / cf:deploy scripts read production.public.env.
# Leave the Auth0 values empty to build without login (the app then runs in open demo mode).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
