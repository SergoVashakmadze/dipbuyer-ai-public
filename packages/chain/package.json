{
  "name": "@dipbuyer/chain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@dipbuyer/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./isomorphic": {
      "@dipbuyer/source": "./src/isomorphic.ts",
      "types": "./dist/isomorphic.d.ts",
      "default": "./dist/isomorphic.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: chain'",
    "test": "vitest run"
  },
  "dependencies": { "@dipbuyer/shared": "workspace:*", "algosdk": "^3.1.0" },
  "devDependencies": { "vitest": "^4.1.11" }
}
