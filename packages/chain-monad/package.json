{
  "name": "@dipbuyer/chain-monad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@dipbuyer/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "@dipbuyer/source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: chain-monad'",
    "test": "vitest run",
    "compile": "node scripts/compile.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:sol": "forge test"
  },
  "dependencies": {
    "@dipbuyer/shared": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "solc": "^0.8.37",
    "vitest": "^4.1.11"
  }
}
