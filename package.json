{
  "name": "dipbuyer-ai",
  "version": "0.1.0",
  "private": true,
  "description": "DipBuyer AI — autonomous Peter Lynch value-investing agent with provable on-chain audit trail.",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @dipbuyer/api dev",
    "dev:web": "pnpm --filter @dipbuyer/web dev",
    "start:api": "node apps/api/dist/main.js",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "config:check": "node scripts/check-config-drift.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
