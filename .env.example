# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
# Agent operating mode: RESEARCH_ONLY | ADVISORY | DISCRETIONARY
RUNTIME_MODE=RESEARCH_ONLY
# Execution: PAPER | LIVE  (LIVE additionally requires LIVE_TRADING_ENABLED=true + legal sign-off)
RUNTIME_EXECUTION=PAPER
LIVE_TRADING_ENABLED=false
RUNTIME_HALT=false

# ── Investing agent (docs/AGENT.md) ─────────────────────
# Force the in-memory paper broker even when Alpaca keys are set (demos; never touches Alpaca)
BROKER=
# Keep agent run history across restarts (JSON file). Empty = in memory only.
AGENT_RUNS_PATH=
# Scheduled runs: off | daily | weekly | monthly (UTC, weekdays). Scheduled runs only PLAN...
AGENT_SCHEDULE=off
AGENT_SCHEDULE_TIME_UTC=21:30
# ...unless this is true AND RUNTIME_MODE=DISCRETIONARY (plus the halt and live-trading gates).
AGENT_SCHEDULE_AUTO_EXECUTE=false

# ── Database / cache ────────────────────────────────────
DATABASE_URL=postgresql://dipbuyer:dipbuyer@localhost:5432/dipbuyer
REDIS_URL=redis://localhost:6379

# ── Auth0 (identity + KYC/KYB + M2M agent auth) ─────────
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://api.dipbuyer.ai
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# ── KYC/IDV providers (abstracted behind IKycProvider) ──
# Identity verification (the onboarding flow). Empty KYC_PROVIDER = Persona when its keys are set,
# else the DEMO mock (instant approval, no documents checked, labelled "demo" everywhere).
KYC_PROVIDER=                # persona | mock | entrust (not implemented)
ENTRUST_API_KEY=
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
# Signs Persona webhooks (POST /api/kyc/webhook/persona). Without it webhooks are rejected;
# status polling still works.
PERSONA_WEBHOOK_SECRET=
# Investor records (profile, KYC, suitability; personal data). Default apps/api/.data/investors.json
INVESTOR_STORE_PATH=

# ── Brokerage / market data (Alpaca) ────────────────────
ALPACA_ENV=paper             # paper | live
ALPACA_REGION=us             # us | eu  (eu = Alpaca Europe / ex-WealthKernel, FCA-authorised)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex         # iex (free) | sip (paid)

# ── Backtest price history (Polygon.io, now Massive.com) ─
# Which source the BACKTEST reads prices from: alpaca (default) | polygon. Live trading and
# analysis always use Alpaca; this only affects backtests. With polygon, Alpaca keys are not
# required, and the run fails loudly if POLYGON_API_KEY is empty.
# Plan history limits apply (Basic 2y, Starter 5y, Developer 10y, Advanced all) — a 2016 start
# needs more than 10 years. Check with apps/api/scripts/compare-price-sources.mjs first.
BACKTEST_PRICE_SOURCE=alpaca
# Backtest defaults since 2026-09-16 (HANDOVER.md experiments R1-R5):
#   BACKTEST_CASH_POLICY=benchmark   idle cash parked in SPY; tbill | none to change
#   BACKTEST_CIK_OVERRIDES=1         delisted S&P members resolvable; 0 reproduces older runs
# Use the full SIP history feed for backtests (IEX history starts 2018-2020):
# ALPACA_DATA_FEED=sip
POLYGON_API_KEY=

# Sharadar (Nasdaq Data Link): point-in-time fundamentals + delisted prices, 1998+. Research only.
# Free account = sample/metadata; the full tables need a Sharadar subscription.
NASDAQ_DATA_LINK_API_KEY=
# Optional. Default https://api.massive.com; https://api.polygon.io still works.
POLYGON_BASE_URL=

# ── Fundamentals (Alpaca has NONE — required) ───────────
FINANCIALDATASETS_API_KEY=

# SEC EDGAR fundamentals — FREE, no key. Live analysis uses it when FINANCIALDATASETS_API_KEY is
# empty; BACKTESTS prefer it whenever this is set (exact filing dates). The SEC requires a descriptive User-Agent identifying you (name + contact email) and
# rejects requests without one; rate limit ~10 req/s. US filers only.
# Advantage over the paid path: EDGAR publishes the real `filed` date, so point-in-time is exact
# rather than a 90-day estimate. Prices for PE/market-cap come from Alpaca when configured
# (in a backtest: from BACKTEST_PRICE_SOURCE, unadjusted).
# e.g. SEC_EDGAR_USER_AGENT="DipBuyer AI research you@example.com"
SEC_EDGAR_USER_AGENT=
# (No fundamentals fallback is implemented. POLYGON_API_KEY above is read for backtest PRICES only;
# INTRINIO_API_KEY is not read anywhere.)

# ── Research pages (/research/*, web /stock, /opportunities) ──
# Screener universe override, comma-separated. Default is a curated list of 36 US large caps
# (apps/api/src/research/universe.ts). Never point this at the vendored S&P membership file:
# its licence forbids surfacing it through the API.
# RESEARCH_UNIVERSE=AAPL,MSFT,NKE
# Screener cache lifetime in ms (default 30 minutes). Each refresh costs one fundamentals fetch
# and one price-history fetch per name.
# RESEARCH_SCREENER_TTL_MS=1800000

# ── Macro ───────────────────────────────────────────────
FRED_API_KEY=

# ── LLM reasoning core (runs PROMPT.md) ─────────────────
# Provider-agnostic (OpenAI-compatible). Default provider is Groq (free tier).
# Swap providers by changing LLM_BASE_URL + LLM_MODEL:
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1            LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1             LLM_MODEL=<e.g. a :free model>
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=<gemini flash>
#   NVIDIA      LLM_BASE_URL=https://integrate.api.nvidia.com/v1      LLM_MODEL=<nemotron>
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1                LLM_MODEL=<local model>  (LLM_API_KEY=ollama)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ── Algorand (audit anchoring; never write PII/MNPI) ────
ALGORAND_NETWORK=testnet     # testnet | mainnet
ALGORAND_ANCHOR_MNEMONIC=    # hot wallet for hash-anchoring (keep in vault, not here)
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
ALGOD_URL=https://testnet-api.algonode.cloud

# ── Web (Next.js public) ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.dipbuyer.ai

# ── Observability ───────────────────────────────────────
SENTRY_DSN=

# ---- Admin (operator console at /admin) ----
# Auth0 user IDs (token "sub") allowed into /admin, comma-separated. Sign in and open /admin to see yours.
ADMIN_SUBJECTS=
# Local development only, without Auth0: treat the local user as admin. Ignored when NODE_ENV=production.
ADMIN_ALLOW_LOCAL=

# ---- Schedules (all off by default) ----
# Model portfolios: rebalance + create follower copy plans. daily | weekly | monthly; time in UTC.
MODELS_SCHEDULE=
MODELS_TIME_UTC=21:30
# Weekly digest email to opted-in investors.
DIGEST_SCHEDULE=
DIGEST_TIME_UTC=07:00
# Re-check watchlists in the background every N hours (otherwise on read, at most hourly).
WATCHLIST_CHECK_HOURS=

# ---- Data files (defaults under apps/api/.data or ~/dipbuyer-data) ----
MODELS_DIR=
WATCHLIST_PATH=
PORTFOLIO_LEDGER_PATH=
PORTFOLIO_SNAPSHOTS_PATH=
# Output of apps/api/scripts/build-insider-recent.mjs. The API refreshes it itself when INSIDER_REFRESH=daily
# (at INSIDER_REFRESH_TIME_UTC, and at startup when missing or older than a day). Keep it on a persistent volume.
INSIDER_RECENT_PATH=
INSIDER_REFRESH=
INSIDER_REFRESH_TIME_UTC=06:00
INSIDER_REFRESH_DAYS=120

# ---- Email. EMAIL_PROVIDER = log (default: nothing is sent) | resend | cloudflare ----
# Resend suits the weekly digest (newsletter-style). Cloudflare Email Service is for transactional mail only.
APP_URL=https://dipbuyer.ai
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
