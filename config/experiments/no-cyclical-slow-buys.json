        ],
        "too_hot_above_pct": 25,
        "exclude_above_pct": 50
      },
      "buy": {
        "peg": {
          "lte": 1.0
        },
        "max_debt_to_equity": 0.33,
        "require_room_to_expand": true,
        "large_fastgrower_max_pe": 40,
        "large_fastgrower_min_sales_usd": 1000000000
      },
      "sell": {
        "peg": {
          "gte": 2.0
        },
        "growth_deceleration": true,
        "same_store_sales_flat": true,
