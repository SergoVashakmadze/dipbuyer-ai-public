      },
      "buy": {
        "min_dividend_yield_pct": 3.0,
        "require_dividend_well_covered": true,
        "min_payout_cover": 1.5
      },
      "sell": {
        "dividend_cut_risk": true,
        "lost_yield_advantage": true
      },
      "weights": {
        "dividend_yield": 0.35,
        "dividend_cover": 0.25,
        "debt_to_equity": 0.2,
        "fcf_positive": 0.2,
        "value_trap_guard": 0.1
      },
      "provenance": "impl_default"
    },
    "stalwart": {
      "id": {
        "eps_growth_pct": {
          "gte": 10,
          "lte": 20
        },
