{
  "$schema": "./strategy.schema.json",
  "version": "0.3.0-exp-no-cyclical-slow-buys",
  "changelog_0_3_0": "2026-09-16 methodology audit on live SEC EDGAR data. Engine rules, no threshold changes: (1) insufficient valuation data abstains instead of scoring 0 = avoid; (2) dividend_cover criterion now computed (weight was configured but inert); (3) PEGY undefined for non-positive EPS growth; (4) cyclical category from SEC SIC when the source gives no cyclicality; (5) cycle_position criterion computed from EPS history (weight was configured but inert); (6) EDGAR EPS growth is a multi-year CAGR, not one year.",
  "description": "Canonical, machine-readable Peter Lynch strategy thresholds. SINGLE SOURCE OF TRUTH. PROMPT.md cites these illustratively but MUST NOT contradict them; CI fails on drift. Thresholds are research-derived (see DipBuyer-AI-Research-Brief.md \u00a71) and tagged by provenance: 'lynch_book' (Lynch's own numbers) vs 'impl_default' (canonical encoded screens e.g. Validea/AAII).",
  "conventions": {
    "peg_convention": "lower_is_better",
    "peg_note": "PEG = PE / EPS_growth_pct_whole_number. PEGY = PE / (EPS_growth_pct + dividend_yield_pct). NEVER mix with the reciprocal (growth+yield)/PE form.",
    "growth_units": "whole_number_percent"
  },
  "understandability_gate": {
    "require_business_summary": true,
    "require_growth_story": true,
    "max_complexity_flag": "moderate"
  },
  "categories": {
    "slow_grower": {
