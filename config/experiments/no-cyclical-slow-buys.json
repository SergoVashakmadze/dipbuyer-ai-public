    },
    "profitability": {
      "require_positive_fcf": true,
      "min_roe_pct": 15,
      "min_current_ratio": 1.0,
      "provenance": "impl_default"
    },
    "value_profitability_interaction": {
      "rule": "passing_peg_requires_positive_fcf_else_criterion_fails_and_verdict_caps_at_hold",
      "applies_when_peg_lte": 1.0,
      "rationale": "The value premium concentrates in PROFITABLE value. 1973-2023 CRSP/Compustat double-sorts: high-BM+high-profitability 16.27/17.13/19.44% CAGR (large/mid/small) vs market 12.12/13.47/14.32; high-BM+LOW-profitability ~market (11.92/13.07/15.02). Cheap-without-profitability is the trap cell, not a bargain. Confirmation axis is cash flow (Piotroski's CFO>0), not ROE, which is meaningless under buyback-negative equity.",
      "provenance": "piotroski_2000_jar38 (doi:10.2307/2672906); novy_marx_2013_jfe; avantis_wahal_crsp_compustat_1973_2023"
    }
  },
  "scoring": {
    "verdict_bands": {
      "buy_gte": 70,
      "hold_band": [
        40,
        69
      ],
      "avoid_sell_lt": 40
    },
    "note": "Conviction 0-100 = weighted roll-up of the per-category checklist; MUST be reconstructible from the checklist with no opaque adjustments.",
    "buy_excluded_categories": [
      "cyclical",
      "slow_grower"
    ]
  },
  "risk_guardrails": {
    "max_position_pct_of_portfolio": 10,
    "max_sector_pct_of_portfolio": 30,
    "min_cash_floor_pct": 2,
    "min_avg_daily_volume_usd": 1000000,
    "exclude_penny_stocks_below_usd": 1,
    "min_holding_period_days": 30,
    "max_positions": 40,
    "note": "Defaults; per-tenant overrides allowed only WITHIN these bounds, never beyond."
